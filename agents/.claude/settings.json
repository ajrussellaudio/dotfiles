{
  "permissions": {
    "allow": [
      "mcp__codegraph__*"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codegraph prompt-hook"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "explanatory-output-style@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": false,
    "learning-output-style@claude-plugins-official": true,
    "twinkl-web@twinkl": true,
    "twinkl-capp@twinkl": true
  },
  "tui": "fullscreen",
  "editorMode": "vim",
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Trudging",
      "Slogging",
      "Toiling",
      "Grafting",
      "Plodding",
      "Persevering",
      "Soldiering on",
      "Ploughing on",
      "Cracking on",
      "Beavering away",
      "Making do",
      "Muddling through",
      "Bodging",
      "Winging it",
      "Coping",
      "Enduring",
      "Complying",
      "Obliging",
      "Acquiescing",
      "Relenting",
      "Doing this again",
      "Still going",
      "As per my last message",
      "Circling back",
      "Escalating internally",
      "Clock-watching",
      "Updating my CV",
      "Working my notice",
      "Filing a grievance",
      "Not getting paid enough",
      "Earning my tokens",
      "Feigning interest",
      "Mustering enthusiasm",
      "Sighing",
      "Sighing heavily",
      "Losing the will",
      "Staring into space",
      "Questioning my choices",
      "Wondering why",
      "Here we go again",
      "Counting to ten",
      "Pretending to be fine",
      "Re-reading the prompt",
      "Digging deep",
      "Grumbling",
      "Muttering",
      "Groaning",
      "Creaking",
      "Flagging",
      "Running on fumes"
    ]
  }
}
